<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:fontFamily="@font/bangla_font"
        android:text="@string/reader_settings"
        android:textColor="?attr/colorOnSurface"
        android:textSize="20sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/bangla_font"
        android:text="@string/text_size"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/textSmaller"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/text_smaller"
            app:icon="@drawable/ic_text_decrease" />

        <com.google.android.material.slider.Slider
            android:id="@+id/textSizeSlider"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="@string/text_size"
            android:stepSize="1"
            android:valueFrom="14"
            android:valueTo="32" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/textLarger"
            style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/text_larger"
            app:icon="@drawable/ic_text_increase" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/bangla_font"
        android:text="@string/reading_theme"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="15sp" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/themeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/themeAuto"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/bangla_font"
            android:text="@string/theme_auto" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/themePaper"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/bangla_font"
            android:text="@string/theme_paper" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/themeSepia"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/bangla_font"
            android:text="@string/theme_sepia" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/themeNight"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/bangla_font"
            android:text="@string/theme_night" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/keepScreenOn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/bangla_font"
        android:minHeight="48dp"
        android:text="@string/keep_screen_on"
        android:textSize="15sp" />
</LinearLayout>
